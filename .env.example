# OpenAgentic 3rd Party Provider Configuration
OPENAGENTIC_API_KEY=""
OPENAGENTIC_BASE_URL="https://openagentic.id/api/v1"
OPENAGENTIC_MODEL="claude-sonnet-4.6"

# Layer-Specific Model Optimizations for Token Efficiency
OPENAGENTIC_ROUTER_MODEL="claude-3-5-haiku-20241022"
OPENAGENTIC_GENERATOR_MODEL="claude-sonnet-4.6"
OPENAGENTIC_EXTRACTOR_MODEL="claude-sonnet-4.6"

# Fallback Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# PostgreSQL + pgvector Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Extraction & Cache Settings
EXTRACTION_CACHE_DIR=./cache/extractions
ENTITY_RESOLUTION_THRESHOLD=0.85
